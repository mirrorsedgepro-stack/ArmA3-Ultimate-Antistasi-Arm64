# ==============================================================================
# Steam Authentication
# SteamCMD requires a valid Steam account to download Arma 3 Workshop mods.
# For security, you can use a secondary Steam account.
# ==============================================================================
STEAM_USER=your_steam_username
STEAM_PASSWORD=your_steam_password
# If your Steam account requires Steam Guard, you can put the code here or run './scripts/manage.sh steam-login'
STEAM_GUARD_CODE=
STEAM_PLATFORM=linux64
STEAM_BRANCH=public
STEAM_BRANCH_PASSWORD=

# ==============================================================================
# Arma 3 Server Engine Settings
# ==============================================================================
# Use 64-bit binary to avoid 32-bit memory cap crashes with 32 players + mods
ARMA_BINARY=./arma3server_x64
ARMA_CONFIG=main.cfg
ARMA_PROFILE=antistasi_server
PORT=2302

# Server tickrate target (60 FPS provides high AI responsiveness and stability)
ARMA_LIMITFPS=60
ARMA_WORLD=empty

# Engine flags:
# -cfg=/arma3/configs/basic.cfg : loads 32-player network bandwidth tuning
# -autoInit                    : automatically initializes mission without waiting in lobby
# -enableHT                    : enables Hyper-Threading optimizations on multi-core CPUs
ARMA_PARAMS=-cfg=/arma3/configs/basic.cfg -autoInit -enableHT

# ==============================================================================
# Headless Clients (HCs) for AI Offloading
# Distributes Antistasi enemy patrols, garrisons, and QRFs across CPU cores
# ==============================================================================
HEADLESS_CLIENTS=3
HEADLESS_CLIENTS_PROFILE=$$profile-hc-$$i

# ==============================================================================
# Mod Configuration
# Point to the HTML preset containing RHS, CBA_A3, and Antistasi Ultimate
# ==============================================================================
MODS_PRESET=/arma3/configs/preset.html
MODS_LOCAL=true
CLEAR_KEYS=false
ARMA_CDLC=


# ==============================================================================
# Server Passwords (filled into configs/main.cfg placeholders by launch.py)
# Single-quote values so Compose doesn't interpolate '$' characters
# ==============================================================================
ARMA_PASSWORD='your_server_join_password'
ARMA_PASSWORD_ADMIN='your_secret_admin_password'
ARMA_PASSWORD_COMMAND=''

# ==============================================================================
# Discord Message API & Bot Configuration
# ==============================================================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_MONITOR_CHANNEL=123456789012345678
DISCORD_ADMIN_CHANNEL=123456789012345678
DISCORD_LOG_CHANNEL=123456789012345678
DISCORD_ADMIN_LOG_CHANNEL=123456789012345678
DISCORD_API_KEY=your_generated_secret_api_key
DISCORD_JWT_SECRET=your_generated_jwt_secret

# ==============================================================================
# TELEMETRY BRIDGE CONFIGURATION (ArmA3-Monitor)
# ==============================================================================
TELEMETRY_PORT=2310
TELEMETRY_API_KEY=
SERVER_PUBLIC_IP=180.181.238.103
